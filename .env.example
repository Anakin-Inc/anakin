# AnakinScraper Configuration
# Copy to .env and modify as needed

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anakinscraper?sslmode=disable

# Server
PORT=8080

# API key. When set, every /v1 route requires it as X-API-Key or
# Authorization: Bearer <key>. Leave empty for an open instance — only safe when the
# port is not reachable by anything you do not trust. Domain config writes
# (POST/PUT/DELETE /v1/domain-configs) always require a key.
API_KEY=

# Browser origins allowed to call this API and read the responses.
# Comma-separated; defaults to the webapp dev server. "*" lets any website a browser
# visits drive this instance — do not use it on a machine you care about.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Browser Service (Playwright WebSocket)
BROWSER_WS_URL=ws://localhost:9222/camoufox
BROWSER_TIMEOUT=60
BROWSER_LOAD_WAIT=2

# Job Processing
WORKER_POOL_SIZE=5
JOB_BUFFER_SIZE=100
JOB_TIMEOUT=120

# Logging
LOG_LEVEL=INFO

# Proxy (optional)
PROXY_URL=

# SSRF guard: scrape targets resolving to loopback, private, or link-local addresses
# (including the 169.254.169.254 cloud metadata endpoint) are rejected with a 400.
# Set to true ONLY if this server is trusted to scrape your internal network.
ALLOW_PRIVATE_TARGETS=false

# Gemini API key (optional — enables generateJson for structured data extraction)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anakin.io API handler (optional — fallback when local HTTP + browser handlers fail)
# Get a free key at https://anakin.io/dashboard
# When set, adds anakin.io as the last handler in the chain for hard-to-scrape sites
ANAKIN_API_KEY=

# Per-scrape settlement via an x402 facilitator (optional — last-resort chain
# fallback, so it only runs when every other handler has failed). Callers send a
# signed payment in the X-PAYMENT header and pay per scrape instead of holding a
# prepaid contract. The server never holds a wallet key: callers sign with their
# own wallet, and you only configure a receiving address.
# See docs/handlers.md for the full request flow.
XNO_FACILITATOR_URL=
# Facilitator's identifier for the settlement network. Confirm your facilitator
# supports it — the server cannot settle on another network.
XNO_NETWORK=
XNO_PAY_TO=
# Price of one scrape in the asset's smallest unit. "1 XNO" = 1000000, "$0.01" USDC = 10000.
XNO_AMOUNT=
# Asset identifier in the facilitator's convention (contract address on EVM).
XNO_ASSET=
# Human-readable asset label used in logs and error messages.
XNO_ASSET_NAME=
# XNO_SCHEME=exact
# XNO_RESOURCE=/v1/scrape
# Set to "off" to verify payments without settling them.
# XNO_SETTLE=on
# XNO_TIMEOUT=15

# Telemetry (anonymous usage data — see TELEMETRY.md for details)
# Set to "off" to disable: TELEMETRY=off
# TELEMETRY=on
# TELEMETRY_URL=  # defaults to https://telemetry.anakin.io/v1/collect
